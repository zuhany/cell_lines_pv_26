@article{zhangAgingSenescenceKey2025,
  title = {Aging and Senescence: {{Key}} Players in Brain Tumor Progression and Drug Resistance},
  shorttitle = {Aging and Senescence},
  author = {Zhang, Chao and {Neha} and Zhang, Jiaqi and Dhaha, Prashant and Li, Xiaodie and Mishra, Sarad Kumar and Fleishman, Joshua and Parvez, Suhel and Jha, Saurabh Kumar and Huang, Min},
  year = 2025,
  month = jul,
  journal = {Drug Resistance Updates},
  volume = {81},
  pages = {101228},
  issn = {13687646},
  doi = {10.1016/j.drup.2025.101228},
  urldate = {2026-07-26},
  abstract = {Aging plays a critical role in the development, progression, and therapeutic challenges associated with brain tumors, particularly glioblastomas (GBM). As the population ages, the incidence of brain tumors, including GBM, increases, with aging emerging as a significant prognostic factor influencing survival outcomes. This review examines the molecular mechanisms linking aging and brain tumor progression, with a specific focus on glioblastomas. We explore how age-related genetic mutations, alterations in cellular pathways, and changes in the tumor microenvironment (TME) contribute to tumorigenesis and treatment resistance. Furthermore, we highlight the impact of key signaling pathways, such as the PI3K/AKT/mTOR, p53, and EGFR/PTEN, which are frequently dysregulated in both aging and brain tumors. Despite the growing recognition of aging as a critical factor in brain tumor biology, therapeutic strategies for elderly patients remain poorly defined, often due to underrepresentation in clinical trials and the complex interplay of comorbidities and treatment side effects. The review also discusses emerging therapeutic approaches, including targeted therapies and immunotherapies, which offer promise for improving treatment outcomes by addressing age-related molecular changes. Finally, we emphasize the importance of personalized treatment strategies and the need for further research to better understand the biological mechanisms underlying the aging-brain tumor relationship, ultimately aiming to enhance clinical management and patient quality of life.},
  langid = {english},
  keywords = {Aging,Autophagy,GBM,Genetic Alterations & Immunological changes,miRNA,Synaptic Plasticity,Therapeutic interventions},
  file = {/Users/viki/Zotero/storage/5T33EENI/Zhang et al. - 2025 - Aging and senescence Key players in brain tumor progression and drug resistance.pdf;/Users/viki/Zotero/storage/AYVZSFQ9/S1368764625000287.html;/Users/viki/Zotero/storage/P9HNJH74/S1368764625000287.html}
}
